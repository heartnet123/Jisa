# ==============================================================================
# Jisa - Environment Configuration Example
# Copy this file to .env (or .env.local for Next.js) and modify as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
UPLOAD_DIR=uploads
# STATE_DB_PATH=uploads/state.sqlite3
# MAX_UPLOAD_SIZE_BYTES=26214400
# MAX_BATCH_UPLOAD_FILES=20
# DEVICE=cuda   # Options: cuda, cpu, mps
# TYPESETTING_FONT=

# ------------------------------------------------------------------------------
# OCR & Vision Model Settings
# ------------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OCR_MODEL=glm-ocr
OCR_TIMEOUT=180.0
OCR_CONCURRENCY=2

# ------------------------------------------------------------------------------
# LLM / Translation Settings (BYOK - Bring Your Own Key)
# ------------------------------------------------------------------------------
# Default fallback model across all providers if not specified
BYOK_DEFAULT_MODEL=gpt-5.4-mini

# Server-side default provider credentials (optional, can be overridden per request)
# BYOK_PROVIDER=openai
# BYOK_API_KEY=your_api_key_here
# BYOK_API_BASE=https://api.openai.com/v1
# BYOK_MODEL=gpt-4o

# Custom OpenAI-compatible provider base URL
CUSTOM_PROVIDER_BASE=http://localhost:8000/v1

# Full-page context translation flag (true/false)
PAGE_CONTEXT_TRANSLATION=true

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
